# Crucible environment template. Every variable here is read by server/config.py
# or docker-compose.yml. Copy to .env and adjust.

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production | test

# --- Database ----------------------------------------------------------------
# SQLite for local dev; any postgresql:// URL in production (required there).
DATABASE_URL=sqlite+aiosqlite:///./crucible.db
# asyncpg prepared-statement cache; keep 0 behind PgBouncer / Supabase pooler.
DB_STATEMENT_CACHE_SIZE=0

# --- Authentication ----------------------------------------------------------
# JWT signing secret; production refuses the dev default. openssl rand -hex 32
CRUCIBLE_SECRET_KEY=change-me-to-at-least-32-random-characters
CRUCIBLE_TOKEN_EXPIRE_MINUTES=60
# Optional operator key (X-API-Key, sees all users' data). Empty = disabled.
CRUCIBLE_API_KEY=
CRUCIBLE_API_KEY_PREFIX=cr_

# --- Storage, limits, inference ---------------------------------------------
CRUCIBLE_MODEL_DIR=/tmp/models
MAX_UPLOAD_BYTES=104857600         # /convert and /validate
MAX_REQUEST_BODY_BYTES=16777216    # every other route
MAX_INPUT_ELEMENTS=4000000
MAX_BATCH_SIZE=32
INFERENCE_TIMEOUT_SEC=60
MAX_CONCURRENT_INFERENCES=2
MODEL_CACHE_SIZE=4

# --- CORS / logging ----------------------------------------------------------
CRUCIBLE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CRUCIBLE_LOG_LEVEL=INFO
CRUCIBLE_LOG_FORMAT=console        # console | json

# --- Offline training tooling (server/ml) ------------------------------------
CRUCIBLE_TRAIN_DATA=data/raw/creditcard.csv
CRUCIBLE_MODEL_OUTPUT=models/fraud_model.onnx

# --- docker-compose only -----------------------------------------------------
POSTGRES_PASSWORD=crucible
GF_ADMIN_PASSWORD=change-me
