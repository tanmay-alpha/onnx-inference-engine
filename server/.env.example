# Crucible server environment (copy to .env in the directory you start uvicorn from).

# SQLite for local dev; postgresql://user:pass@host:5432/db in production
# (mapped to asyncpg for async sessions and psycopg2 for sync CRUD).
DATABASE_URL=sqlite+aiosqlite:///./crucible.db

# JWT signing secret. Production refuses the default; use >= 32 random chars.
CRUCIBLE_SECRET_KEY=dev-secret-key-change-in-production-please-use-a-real-secret

# Optional operator key (X-API-Key) that can see every user's data. Empty = disabled.
CRUCIBLE_API_KEY=

CRUCIBLE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://crucible-ivory-three.vercel.app
CRUCIBLE_MODEL_DIR=/tmp/models

# Limits
MAX_UPLOAD_BYTES=52428800
MAX_CONCURRENT_ANALYSES=1
MAX_GRAPH_NODES=2000
MAX_MODELS_PER_USER=20
MAX_STORAGE_BYTES_PER_USER=209715200
MAX_REQUEST_BODY_BYTES=16777216
MAX_INPUT_ELEMENTS=4000000
MAX_OUTPUT_ELEMENTS=1000000
MAX_TENSOR_ELEMENTS=16000000
MAX_TOTAL_ELEMENTS=64000000
INFERENCE_TIMEOUT_SEC=60
MAX_CONCURRENT_INFERENCES=2
MODEL_CACHE_SIZE=4

# Rate limits (per process). TRUST_PROXY_HEADERS=true only behind a proxy that
# sets the first X-Forwarded-For entry itself (e.g. Render).
TRUST_PROXY_HEADERS=false
AUTH_RATE_LIMIT_PER_IP=30
AUTH_RATE_LIMIT_PER_IP_EMAIL=10
AUTH_RATE_WINDOW_SEC=300

CRUCIBLE_LOG_LEVEL=INFO
