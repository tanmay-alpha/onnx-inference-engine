# Crucible web frontend configuration.
# Copy to .env.local for development, or set in the Vercel project settings.
# Vite inlines VITE_* variables at build time, so changing it requires a rebuild.

# Base URL of the Crucible FastAPI server (no trailing slash).
# If unset, the app uses http://localhost:8000.
VITE_API_URL=http://localhost:8000
