# EditorConfig for Crucible — ONNX Inference Engine
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,ts,tsx,json,yml,yaml}]
indent_size = 2

[*.{c,cpp,h,hpp}]
indent_size = 4

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
